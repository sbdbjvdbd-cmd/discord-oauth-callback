# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
GUILD_ID=your_guild_id_for_instant_sync

# ── TikTok OAuth ──────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
OAUTH_REDIRECT_URI=https://your-render-url.onrender.com/tiktok/callback

# ── Security ──────────────────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_secret_key_here

# ── TikTok Domain Verification ────────────────────────────────────────────────
TIKTOK_VERIFY_TOKEN=tiktok-developers-site-verification=your_token_here

# ── Bot Settings ──────────────────────────────────────────────────────────────
ALLOWED_CHANNEL_ID=0

# ── Rate Limits (optional) ────────────────────────────────────────────────────
RATE_USERNAME_CHECK=10
RATE_4L_FINDER=1
RATE_4L_FINDER_DAY=20
FINDER_MAX_CHECKS=30

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PATH=data/app.db
