# ─── Discord ───────────────────────────────────────────────
# Bot-Token aus https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=your_discord_bot_token

# Application-ID deiner Discord-App
DISCORD_CLIENT_ID=your_discord_application_client_id

# Client-Secret deiner Discord-App (für guilds.join OAuth2)
# Zu finden unter: https://discord.com/developers/applications -> OAuth2 -> Client Secret
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Guild-ID des Servers dem User beitreten sollen (Standard: Haupt-Server)
DISCORD_GUILD_ID=1253800682415325214

# ─── TikTok OAuth ──────────────────────────────────────────
# Aus https://developers.tiktok.com/ -> Deine App -> Client Key & Secret
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# ─── OAuth Callback Server ─────────────────────────────────
# Vollständige URL die TikTok nach dem Login aufruft.
# Muss EXAKT im TikTok Developer Portal unter "Redirect URI" eingetragen sein.
# Lokal:      http://localhost:8080/callback
# Production: https://deinedomain.com/callback
OAUTH_REDIRECT_URI=http://localhost:8080/callback

# Lokaler Port für den OAuth-Server
SERVER_PORT=8080

# ─── Sicherheit ────────────────────────────────────────────
# Zufälliger langer String für Token-Verschlüsselung in der Datenbank.
# Generieren mit: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secret_key

# ─── Datenbank ─────────────────────────────────────────────
DATABASE_URL=sqlite:///data/app.db
